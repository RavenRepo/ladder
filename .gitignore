__pycache__/
*.pyc
.omc/

# Generated by runs. A fresh clone must start with an EMPTY outcome history:
# these files ARE the routing policy's evidence, and inheriting someone else's
# would make the policy believe things about your workload that were measured
# on theirs.
10-returns/*/
20-graph/outcomes.jsonl
20-graph/substrate.json
40-runs/*.md

# Shared: the system appends, a human writes decisions under the entries.
# Untracked because it is local operational state, not part of the workspace.
30-queries/needs-human.md
